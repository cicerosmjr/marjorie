---
interface Props {
  name: string;
}

const { name } = Astro.props;
---

{
  name === 'document' && (
    <svg class="icon" viewBox="0 0 24 24" aria-hidden="true">
      <rect x="6" y="3" width="12" height="18" rx="1.2" fill="none" stroke="currentColor" stroke-width="1.5" />
      <path d="M9 8h6M9 12h6M9 16h4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
    </svg>
  )
}
{
  name === 'home' && (
    <svg class="icon" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M4 11.5 12 4l8 7.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
      <path d="M7 10.8V20h10v-9.2" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
    </svg>
  )
}
{
  name === 'bottle' && (
    <svg class="icon" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M10 8V4.5h4V8" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
      <rect x="8.5" y="8" width="7" height="12" rx="1.2" fill="none" stroke="currentColor" stroke-width="1.5" />
    </svg>
  )
}
{
  name === 'hands' && (
    <svg class="icon" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M8 14.2c.2-2.2 1.3-3.4 2.6-3.4.8 0 1.4.5 1.5 1.2" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
      <path d="M16 14.2c-.2-2.2-1.3-3.4-2.6-3.4-.8 0-1.4.5-1.5 1.2" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
      <path d="M7.2 14.6c.9 3 2.8 4.6 4.8 4.6s3.9-1.6 4.8-4.6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
    </svg>
  )
}
{
  name === 'signature' && (
    <svg class="icon" viewBox="0 0 24 24" aria-hidden="true">
      <rect x="5" y="3" width="14" height="18" rx="1.2" fill="none" stroke="currentColor" stroke-width="1.5" />
      <path d="M8 15.5c1.2-1.6 2-1.2 2.8.2.7 1.2 1.3.6 2.2-.6.8-1 1.6-.6 2.2.2" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
    </svg>
  )
}
{
  name === 'folder' && (
    <svg class="icon" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M3 7.5h6l2 2H21V20H3Z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
    </svg>
  )
}
{
  name === 'building' && (
    <svg class="icon" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M4 9.5 12 4l8 5.5V20H4Z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
      <path d="M9 20v-4h6v4" fill="none" stroke="currentColor" stroke-width="1.5" />
    </svg>
  )
}
{
  name === 'badge' && (
    <svg class="icon" viewBox="0 0 24 24" aria-hidden="true">
      <rect x="6" y="3.5" width="12" height="17" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.5" />
      <circle cx="12" cy="9" r="1.7" fill="none" stroke="currentColor" stroke-width="1.5" />
      <path d="M9 15.5h6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
    </svg>
  )
}
