---
import { site, waLink } from '../data/site';

interface Props {
  legal?: boolean;
}

const { legal = false } = Astro.props;
const whatsapp = waLink(site.messages.neutral);
---

<header class="header">
  <div class="wrap header-inner">
    <a class="logo" href="/">
      <span class="logo-name">{site.name}</span>
      <span class="logo-area">{site.area}</span>
    </a>
    {
      !legal && (
        <>
          <input class="menu-toggle" id="menu-toggle" type="checkbox" />
          <label class="menu-button" for="menu-toggle">Menu</label>
          <nav class="nav" aria-label="Seções">
            <a href="/#inicio">Home</a>
            <a href="/#pacientes">Pacientes</a>
            <a href="/#medicos">Médicos</a>
            <a href="/#faq">FAQ</a>
            <a class="nav-wa" href={whatsapp}>Fale pelo WhatsApp</a>
          </nav>
        </>
      )
    }
  </div>
</header>

<script>
  document.querySelectorAll('.nav a').forEach((link) => {
    link.addEventListener('click', () => {
      const toggle = document.querySelector<HTMLInputElement>('#menu-toggle');
      if (toggle) toggle.checked = false;
    });
  });
</script>
