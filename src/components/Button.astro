---
interface Props {
  variant?: 'primary' | 'whatsapp' | 'light' | 'ghost' | 'link';
  href?: string;
  type?: 'submit' | 'button';
  compact?: boolean;
}

const { variant = 'primary', href, type = 'submit', compact = false } = Astro.props;
const classes = ['btn', `btn-${variant}`, compact && 'btn-compact'].filter(Boolean).join(' ');
---

{
  href ? (
    <a class={classes} href={href}>
      {variant === 'whatsapp' && (
        <svg class="btn-wa" viewBox="0 0 24 24" aria-hidden="true">
          <path
            fill="currentColor"
            d="M20.5 3.5A11 11 0 0 0 2.1 17.8L1 23l5.3-1.1A11 11 0 0 0 12 22a11 11 0 0 0 8.5-18.5zM12 20.2a9.1 9.1 0 0 1-4.6-1.3l-.3-.2-3.1.8.8-3-.2-.3A9.1 9.1 0 1 1 12 20.2zm5-6.8c-.3-.1-1.6-.8-1.8-.9s-.4-.1-.6.1-.7.9-.9 1.1-.3.2-.6.1a7.4 7.4 0 0 1-2.2-1.4 8.1 8.1 0 0 1-1.5-1.9c-.2-.3 0-.4.1-.6l.4-.4.2-.4a.5.5 0 0 0 0-.5c-.1-.1-.6-1.5-.8-2s-.4-.5-.6-.5h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.9 11.9 0 0 0 4.6 4.1c.6.2 1.1.4 1.5.5a3.6 3.6 0 0 0 1.7.1 2.7 2.7 0 0 0 1.8-1.2 2.2 2.2 0 0 0 .2-1.2c-.1-.2-.3-.2-.6-.4z"
          />
        </svg>
      )}
      <slot />
      {variant !== 'whatsapp' && <span class="btn-arrow" aria-hidden="true">→</span>}
    </a>
  ) : (
    <button class={classes} type={type}>
      <slot />
      <span class="btn-arrow" aria-hidden="true">→</span>
    </button>
  )
}
