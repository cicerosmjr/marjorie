---
import Icon from '../components/Icon.astro';
import Base from '../layouts/Base.astro';
import { homeJsonLd, serializeLd } from '../data/schema';
import {
  contactSteps,
  credentials,
  doctorFronts,
  doctorTags,
  faqs,
  methodSteps,
  patientFronts,
  patientTags,
  patientTeasers,
  photos,
  site,
  waLink,
} from '../data/site';

const patientFaqs = faqs.filter((item) => item.audience === 'pacientes');
const priorityFaqs = patientFaqs.filter((item) => item.priority);
const otherPatientFaqs = patientFaqs.filter((item) => !item.priority);
const doctorFaqs = faqs.filter((item) => item.audience === 'medicos');
const jsonLd = serializeLd(homeJsonLd());
---

<Base title={site.title} description={site.description} jsonLd={jsonLd}>
  <section class="hero" id="inicio">
    <div class="hero-copy">
      <h1>Dra. Marjorie Cordeiro, advogada de Direito Médico e da Saúde</h1>
      <p class="display">{site.phrase}</p>
      <p class="lead">Orientação jurídica para pacientes e profissionais médicos, com uma atuação clara, próxima e responsável.</p>
      <p class="muted">{site.attendance}</p>
      <div class="actions">
        <a class="btn btn-primary" href="#pacientes">Preciso de orientação como paciente</a>
        <a class="btn btn-secondary" href="#medicos">Busco orientação como médico</a>
      </div>
    </div>
    <div class="hero-stage">
      <svg class="leaf leaf-back" viewBox="0 0 120 160" aria-hidden="true">
        <path fill="currentColor" d="M62 8c18 22 34 36 46 62-26 6-42 24-48 52-4-30-18-54-46-72 20-18 32-30 48-42z" />
        <path d="M60 28v96" fill="none" stroke="currentColor" stroke-width="2" />
      </svg>
      <figure class="hero-photo shot-hero">
        <img src={photos.autoridade} alt="Dra. Marjorie Cordeiro, advogada de Direito Médico e da Saúde" width="900" height="1200" />
      </figure>
      <svg class="leaf leaf-front" viewBox="0 0 120 160" aria-hidden="true">
        <path fill="currentColor" d="M58 150C40 128 24 114 12 88c26-6 42-24 48-52 4 30 18 54 46 72-20 18-32 30-48 42z" />
        <path d="M60 132V36" fill="none" stroke="currentColor" stroke-width="2" />
      </svg>
    </div>
  </section>

  <section class="section section-white">
    <div class="wrap split">
      <div>
        <h2>Direito e saúde exigem conhecimento. Mas também clareza.</h2>
        <p>
          Questões de saúde costumam chegar com dúvidas, preocupação e decisões que não podem esperar. Dra. Marjorie Cordeiro atua no encontro entre Direito e Saúde, transformando questões jurídicas complexas em orientação clara e responsável.
        </p>
      </div>
      <blockquote class="quote-card">
        <svg class="leaf leaf-card" viewBox="0 0 120 160" aria-hidden="true">
          <path fill="currentColor" d="M62 8c18 22 34 36 46 62-26 6-42 24-48 52-4-30-18-54-46-72 20-18 32-30 48-42z" />
        </svg>
        <p>{site.signature}</p>
      </blockquote>
    </div>
  </section>

  <section class="section" aria-label="Caminhos de atuação">
    <div class="wrap duo">
      <article class="duo-card" id="atalho-pacientes">
        <p class="kicker">Para pacientes e familiares</p>
        <h2>Quando um problema de saúde também se torna uma questão jurídica, entender o que pode ser feito é o primeiro passo.</h2>
        <ul>
          {patientTeasers.map((item) => <li><strong>{item.title}.</strong> {item.text}</li>)}
        </ul>
        <p>Outras questões envolvendo planos de saúde, SUS, reembolso, reajustes e cancelamentos também podem ser analisadas.</p>
        <a class="btn btn-primary" href="#pacientes">Conheça a atuação para pacientes</a>
      </article>
      <article class="duo-card duo-sage" id="atalho-medicos">
        <p class="kicker">Para médicos e clínicas</p>
        <h2>Segurança jurídica também faz parte da prática médica.</h2>
        <p>Orientação jurídica preventiva para que médicos e clínicas exerçam sua atividade com mais informação e segurança, em temas como:</p>
        <ul>
          {doctorTags.map((tag) => <li>{tag}</li>)}
        </ul>
        <a class="btn btn-primary" href="#medicos">Conheça a atuação para médicos</a>
      </article>
    </div>
  </section>

  <section class="section section-white" id="pacientes" aria-labelledby="titulo-pacientes">
    <div class="wrap">
      <div class="split media-first">
        <div>
          <p class="kicker">Para pacientes</p>
          <h2 id="titulo-pacientes">Direito Médico para pacientes e familiares.</h2>
          <p class="lead">Negativas do plano de saúde, home care e medicamentos: seus direitos explicados com clareza.</p>
          <p>
            Dra. Marjorie Cordeiro atua na orientação jurídica de pacientes e familiares que enfrentam dificuldades relacionadas ao acesso a tratamentos, exames, cirurgias, medicamentos e outros direitos ligados à saúde.
          </p>
          <p>A proposta é compreender a situação, analisar os documentos disponíveis e explicar com clareza as possibilidades de cada caso.</p>
          <div class="actions">
            <a class="btn btn-primary" href={waLink(site.messages.patient)}>Falar pelo WhatsApp</a>
          </div>
        </div>
        <figure class="frame shot-soft">
          <img src={photos.proximidade} alt="Dra. Marjorie Cordeiro em conversa, em ambiente contemporâneo" width="900" height="1200" />
          <svg class="leaf leaf-frame" viewBox="0 0 120 160" aria-hidden="true">
            <path fill="currentColor" d="M62 8c18 22 34 36 46 62-26 6-42 24-48 52-4-30-18-54-46-72 20-18 32-30 48-42z" />
          </svg>
        </figure>
      </div>

      <div class="section-block">
        <h2>Como a orientação jurídica pode ajudar.</h2>
        <div class="cards">
          {
            patientFronts.map((item) => (
              <article class="card">
                <Icon name={item.icon} />
                <h3>{item.title}</h3>
                <p>{item.text}</p>
              </article>
            ))
          }
        </div>
      </div>

      <div class="section-block">
        <h2>Outras demandas também podem ser analisadas.</h2>
        <p>Entre elas:</p>
        <ul class="tags">
          {patientTags.map((tag) => <li>{tag}</li>)}
        </ul>
        <div class="actions">
          <a class="btn btn-primary" href={waLink(site.messages.patient)}>Falar pelo WhatsApp</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-sage" id="medicos" aria-labelledby="titulo-medicos">
    <div class="wrap">
      <div class="split media-first">
        <div>
          <p class="kicker">Para médicos</p>
          <h2 id="titulo-medicos">Orientação jurídica para médicos e clínicas.</h2>
          <p class="lead">Conhecimento jurídico também faz parte de uma prática médica organizada.</p>
          <p>
            A atividade médica envolve não apenas decisões clínicas, mas também documentos, comunicação com pacientes, direitos profissionais e responsabilidades que podem exigir orientação jurídica.
          </p>
          <p>
            A Dra. Marjorie Cordeiro atua de forma preventiva e orientativa, ajudando médicos e clínicas a compreender questões jurídicas relacionadas à prática profissional e a tomar decisões com mais informação e segurança.
          </p>
          <div class="actions">
            <a class="btn btn-primary" href={waLink(site.messages.doctor)}>Falar pelo WhatsApp</a>
          </div>
        </div>
        <figure class="medicos-photo">
          <img src={photos.medicos} alt="Dra. Marjorie Cordeiro à mesa, com documentos e um estetoscópio" width="900" height="1200" />
          <svg class="leaf leaf-medicos" viewBox="0 0 120 160" aria-hidden="true">
            <path fill="currentColor" d="M62 8c18 22 34 36 46 62-26 6-42 24-48 52-4-30-18-54-46-72 20-18 32-30 48-42z" />
          </svg>
        </figure>
      </div>

      <div class="section-block">
        <h2>Como a orientação jurídica pode contribuir para a prática médica.</h2>
        <div class="cards">
          {
            doctorFronts.map((item) => (
              <article class="card">
                <Icon name={item.icon} />
                <h3>{item.title}</h3>
                <p>{item.text}</p>
              </article>
            ))
          }
        </div>
      </div>

      <div class="section-block narrow">
        <h2>Orientação antes e depois de uma dúvida surgir.</h2>
        <p>
          A orientação jurídica não precisa começar apenas quando existe um conflito. Ela pode revisar documentos e identificar pontos de atenção na rotina e, quando já existe uma situação concreta (como uma dúvida sobre documentação ou uma solicitação formal), começa pela análise dos fatos antes de qualquer medida.
        </p>
        <blockquote class="pull">
          <p>Prevenção jurídica não significa trabalhar com medo. Significa tomar decisões com mais informação.</p>
        </blockquote>
        <div class="actions">
          <a class="btn btn-primary" href={waLink(site.messages.doctor)}>Falar pelo WhatsApp</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-white" id="sobre" aria-labelledby="titulo-sobre">
    <div class="wrap split about-split">
      <figure class="shot-round about-photo">
        <img src={photos.retrato} alt="Retrato da Dra. Marjorie Cordeiro" width="900" height="900" />
      </figure>
      <div>
        <h2 id="titulo-sobre">Direito, comunicação e uma forma mais clara de orientar.</h2>
        <p>
          Dra. Marjorie Cordeiro é advogada especialista em Direito Médico e da Saúde e jornalista de formação. Formada em direito pela Universidade de Fortaleza, em 2014, com pós-graduação em processo penal e penal, mestranda na Universidade Católica Portuguesa — UCP Porto e especialização em direito médico e da saúde.
        </p>
        <p>
          Da comunicação vem uma habilidade essencial em uma área marcada por normas, decisões e documentos técnicos: compreender, organizar, contextualizar e traduzir informações complexas.
        </p>
        <p>Sua atuação parte da honestidade: dizer com transparência o que pode ser feito, o que precisa ser analisado e quais caminhos podem ser considerados.</p>
      </div>
      <ul class="credentials">
        {credentials.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="titulo-metodo">
    <div class="wrap">
      <h2 id="titulo-metodo">Entender antes de decidir.</h2>
      <p class="intro">Cada situação tem contexto próprio. Por isso, a atuação segue uma sequência clara:</p>
      <ol class="steps">
        {
          methodSteps.map((step, index) => (
            <li class="step">
              <span class="step-label">{String(index + 1).padStart(2, '0')}</span>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section section-white" aria-labelledby="titulo-contato">
    <div class="wrap split">
      <div>
      <h2 id="titulo-contato">Como funciona o primeiro contato</h2>
      <div class="contact-steps contact-stack">
        {
          contactSteps.map((step, index) => (
            <article class="contact-step">
              <span>{index + 1}</span>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </article>
          ))
        }
      </div>
      <div class="actions">
        <a class="btn btn-primary" href={waLink(site.messages.neutral)}>Falar pelo WhatsApp</a>
      </div>
      </div>
      <figure class="frame shot-blob">
        <img src={photos.proximidade} alt="Dra. Marjorie Cordeiro em um momento de orientação" width="900" height="1200" />
      </figure>
    </div>
  </section>

  <section class="section" id="faq" aria-labelledby="titulo-faq">
    <div class="wrap narrow">
      <h2 id="titulo-faq">Dúvidas frequentes</h2>
      <div class="faq-group">
        <h3>Pacientes e familiares</h3>
        <p>As primeiras perguntas tratam de negativas, tratamentos, home care, medicamentos e terapias para TEA.</p>
        <div class="faq-list">
          {
            priorityFaqs.map((item) => (
              <details class="faq-item">
                <summary><span>{item.question}</span></summary>
                <p>{item.answer}</p>
              </details>
            ))
          }
        </div>
        <div class="faq-list">
          {
            otherPatientFaqs.map((item) => (
              <details class="faq-item">
                <summary><span>{item.question}</span></summary>
                <p>{item.answer}</p>
              </details>
            ))
          }
        </div>
      </div>
      <div class="faq-group">
        <h3>Médicos e clínicas</h3>
        <div class="faq-list">
          {
            doctorFaqs.map((item) => (
              <details class="faq-item">
                <summary><span>{item.question}</span></summary>
                <p>{item.answer}</p>
              </details>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="section cta" aria-labelledby="titulo-cta">
    <div class="wrap">
      <h2 id="titulo-cta">Uma decisão mais segura começa por compreender a situação.</h2>
      <p>Se você é paciente, familiar ou médico, o primeiro passo é entender o contexto e identificar os caminhos que podem ser avaliados.</p>
      <div class="actions">
        <a class="btn btn-light" href="#pacientes">Preciso de orientação como paciente</a>
        <a class="btn btn-ghost" href="#medicos">Busco orientação como médico</a>
      </div>
    </div>
  </section>
</Base>
