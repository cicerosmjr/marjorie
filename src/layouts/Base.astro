---
import '@fontsource/lora/latin-500.css';
import '@fontsource/lora/latin-500-italic.css';
import '@fontsource/lora/latin-ext-500.css';
import '@fontsource/lora/latin-ext-500-italic.css';
import '@fontsource/lora/latin-600.css';
import '@fontsource/lora/latin-ext-600.css';
import '@fontsource/manrope/latin-400.css';
import '@fontsource/manrope/latin-ext-400.css';
import '@fontsource/manrope/latin-500.css';
import '@fontsource/manrope/latin-ext-500.css';
import '@fontsource/manrope/latin-600.css';
import '@fontsource/manrope/latin-ext-600.css';
import '../styles/global.css';
import '../styles/sections.css';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  description: string;
  jsonLd?: string;
  legal?: boolean;
  robots?: string;
}

const { title, description, jsonLd, legal = false, robots = 'index,follow' } = Astro.props;
const pathname = Astro.url.pathname.replace(/index\.html$/, '').replace(/\.html$/, '') || '/';
const canonical = new URL(pathname, site.url).href;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${site.url}/og.jpg`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${site.url}/og.jpg`} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#173C43" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="Resumo para modelos de linguagem" />
    {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
  </head>
  <body>
    <a class="skip" href="#conteudo">Ir para o conteúdo</a>
    <Header legal={legal} />
    <main id="conteudo">
      <slot />
    </main>
    <Footer legal={legal} />
    <WhatsAppFloat />
    <script>
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const revealed = document.querySelectorAll<HTMLElement>('[data-reveal]');
      if (reduceMotion) {
        revealed.forEach((node) => node.classList.add('is-in'));
      } else if (revealed.length) {
        const revealObs = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add('is-in');
              revealObs.unobserve(entry.target);
            });
          },
          { threshold: 0.16, rootMargin: '0px 0px -8% 0px' },
        );
        revealed.forEach((node) => revealObs.observe(node));
      }

      const fab = document.querySelector('.wa-float');
      const hero = document.querySelector('.hero');
      if (fab && hero) {
        const fabObs = new IntersectionObserver(
          ([entry]) => fab.classList.toggle('is-hidden', entry.isIntersecting),
          { threshold: 0.2 },
        );
        fabObs.observe(hero);
      }
    </script>
  </body>
</html>
